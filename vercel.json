{
    "rewrites": [
        { "source": "/api/v2/:path*", "destination": "/api/v2" },
        { "source": "/api/v1/:path*", "destination": "/api/v2" },
        { "source": "/v2/:path*", "destination": "/api/v2" },
        { "source": "/api", "destination": "/api/v2" },
        { "source": "/((?!api/).*)", "destination": "/index.html" }
    ]
}
